# Build tac_plus-ng into a private prefix and run the tests against it.
#
# usage: tac_plus-ng/tests/run-tests [--build-only] [unittest arguments ...]
#
#   run-tests                     build, install, run everything
#   run-tests -k issue132         run the tests whose name contains issue132
#   run-tests --build-only        build and install only
#
# Environment:
#   TACTEST_PREFIX     test an existing installation instead of building one
#   TACTEST_CC         compiler with flags, e.g. "clang -fsanitize=address".
#                      configure keeps only the compiler name, so the flags
#                      are passed again as "make CC=..."
#   TACTEST_CONFIGURE  extra configure arguments, e.g. "--debug --minimum"
#   TACTEST_WORKDIR    scratch directories (default build/tests-work); left
#                      behind for the tests that failed
#   TACTEST_KEEP=1     keep all scratch directories
#   TACTEST_TIMEOUT    limit for the whole test run in seconds (default 600)
#   MAKE               GNU make (default: gmake if there is one, else make)

set -e

TOP=$(cd "$(dirname "$0")/../.." && pwd)
TESTS=$TOP/tac_plus-ng/tests

BUILD_ONLY=
if [ "$1" = "--build-only" ]; then
	BUILD_ONLY=1
	shift
fi

now() { date +%s; }

if [ -z "$TACTEST_PREFIX" ]; then
	# build/<OS> exactly as GNUmakefile names it
	OS=$(uname -s | tr '[:upper:]/ ' '[:lower:]--')-$(uname -r | sed 's/(.*)//' | tr '[:upper:]/ ' '[:lower:]--')-$(uname -m | tr '[:upper:]/ ' '[:lower:]--')
	TACTEST_PREFIX=$TOP/build/$OS/tests-prefix
	MAKE=${MAKE:-$(command -v gmake || echo make)}
	START=$(now)
	cd "$TOP"
	# configure cleans the build only when Makefile.inc changes, and the
	# flags of "make CC=..." don't go there: a build with other flags must
	# not reuse the objects of the previous one
	STAMP=build/$OS/tests-build-flags
	FLAGS="CC=${CC-} TACTEST_CC=${TACTEST_CC-} TACTEST_CONFIGURE=${TACTEST_CONFIGURE-}"
	if [ -d "build/$OS" ] && [ "$(cat "$STAMP" 2>/dev/null)" != "$FLAGS" ]; then
		echo "run-tests: build flags changed, cleaning build/$OS"
		$MAKE clean
	fi
	# no -j: the Makefiles don't declare the dependencies a parallel build needs
	if [ -n "$TACTEST_CC" ]; then
		# shellcheck disable=SC2086
		./configure --prefix="$TACTEST_PREFIX" --with-cc="$TACTEST_CC" $TACTEST_CONFIGURE tac_plus-ng
		$MAKE CC="$TACTEST_CC"
		$MAKE install CC="$TACTEST_CC"
	else
		# shellcheck disable=SC2086
		./configure --prefix="$TACTEST_PREFIX" $TACTEST_CONFIGURE tac_plus-ng
		$MAKE
		$MAKE install
	fi
	echo "$FLAGS" > "$STAMP"
	echo "run-tests: build and install took $(( $(now) - START )) s"
fi

# detect_leaks=0: under ASan, LeakSanitizer would fail even "-v" (see tactest/daemon.py)
ASAN_OPTIONS=detect_leaks=0${ASAN_OPTIONS:+:$ASAN_OPTIONS} "$TACTEST_PREFIX/sbin/tac_plus-ng" -v

[ -n "$BUILD_ONLY" ] && exit 0

export TACTEST_PREFIX
TACTEST_WORKDIR=${TACTEST_WORKDIR:-$TOP/build/tests-work}
export TACTEST_WORKDIR
mkdir -p "$TACTEST_WORKDIR"

TIMEOUT=
command -v timeout >/dev/null 2>&1 && TIMEOUT="timeout ${TACTEST_TIMEOUT:-600}"

START=$(now)
set +e
cd "$TESTS"
$TIMEOUT python3 -m unittest discover -s "$TESTS" -t "$TESTS" -v "$@"
RC=$?
set -e
echo "run-tests: tests took $(( $(now) - START )) s, exit code $RC"
[ $RC -eq 124 ] && echo "run-tests: the test run hit the ${TACTEST_TIMEOUT:-600} s limit"
rmdir "$TACTEST_WORKDIR" 2>/dev/null || echo "run-tests: scratch directories kept in $TACTEST_WORKDIR"
exit $RC
